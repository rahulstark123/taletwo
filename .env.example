# ---------------------------------------------------------------------------
# TaleTwo environment template. Copy to .env.local and fill in real values.
# NEVER commit real credentials. Variables prefixed NEXT_PUBLIC_ are visible
# in the browser bundle; everything else must stay server-only.
# ---------------------------------------------------------------------------

# PostgreSQL on Supabase (used from Milestone 2 onward)
# DATABASE_URL: pooled connection (Supabase "Transaction" pooler, port 6543), used by the app at runtime.
# DIRECT_URL:   direct connection (port 5432), used by Prisma Migrate only.
DATABASE_URL=
DIRECT_URL=

# Supabase project (Auth and Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app, e.g. http://localhost:3000 in development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (Milestone 6). Server-only secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 (S3-compatible) for photo uploads. Server-only.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_STORAGE_PREFIX=taletwo
# Public r2.dev or custom domain for the bucket. Leave empty while photos stay private (signed links).
S3_PUBLIC_BASE_URL=
# Public Razorpay key id, used by the checkout script in the browser.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
GROQ_MODEL=openai/gpt-oss-20b
